# ==============================================
# PLI Demo — Variables de Entorno
# ==============================================
# Copiá este archivo a .env.demo:
#   cp .env.demo.example .env.demo
#
# Después completá las keys marcadas con YOUR_KEY_HERE
# ==============================================

# Flag de demo (NO BORRAR)
DEMO_MODE=true

# Base de datos — Postgres local via Docker (ver DEMO.md)
DATABASE_URL=postgresql://postgres:demo@localhost:5433/pli_demo

# Clerk — Creá una app GRATIS en https://clerk.com
# Dashboard > API Keys > copiá las dos keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE
CLERK_SECRET_KEY=sk_test_YOUR_KEY_HERE

# Stripe — Keys de prueba desde https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_KEY_HERE

# URL local
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Token de checkin staff (cualquier string random para demo)
STAFF_CHECKIN_TOKEN=demo-checkin-token-12345

# Webhook de Clerk (opcional para demo — dejá vacío si no usás webhooks)
CLERK_WEBHOOK_SIGNING_SECRET=
