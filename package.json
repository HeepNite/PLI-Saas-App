{
  "name": "pli-sass",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "build:turbo": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "tsc-noEmit": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/run-playwright.mjs",
    "test:api": "vitest run tests/api",
    "test:db": "vitest run tests/integration",
    "test:security": "vitest run tests/security.test.ts tests/api/staff-school-courses-security.test.ts tests/api/staff-school-upload.test.ts && node scripts/run-playwright.mjs e2e/security-smoke.spec.ts",
    "test:all": "npm run test && npm run test:e2e",
    "spec:list": "node scripts/codex-spec.mjs list",
    "spec:analysis": "node scripts/codex-spec.mjs analysis",
    "spec:resolve": "node scripts/codex-spec.mjs resolve",
    "spec:plan": "node scripts/codex-spec.mjs plan",
    "spec:implement": "node scripts/codex-spec.mjs implement",
    "spec:validate": "node scripts/codex-spec.mjs validate"
  },
  "prisma": {
    "seed": "node --require ./prisma/register-ts.js prisma/seed.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.33.3",
    "@prisma/client": "^6.19.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@stripe/react-stripe-js": "^5.6.0",
    "@stripe/stripe-js": "^8.7.0",
    "argon2": "^0.44.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.29.2",
    "lenis": "^1.3.4",
    "lucide-react": "^0.545.0",
    "next": "^15.5.12",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "stripe": "^20.3.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.51.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.0.18",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "jsdom": "^29.0.1",
    "prisma": "^6.19.2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^4.0.18"
  }
}
