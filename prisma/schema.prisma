generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url = env("DATABASE_URL")
}

model Currency {
  id             String               @id @default(cuid())
  code           String               @unique
  symbol         String?
  decimals       Int?
  active         Boolean              @default(true)
  createdAt      DateTime             @default(now())
  paymentModels  StaffPaymentModel[]  @relation("StaffPaymentModelCurrency")
  paymentMethods StaffPaymentMethod[] @relation("StaffPaymentMethodCurrency")
  payrollEntries StaffPayrollEntry[]  @relation("StaffPayrollEntryCurrency")

  @@index([active])
}

model User {
  id                          String                       @id @default(cuid())
  clerkId                     String?                      @unique
  email                       String                       @unique
  name                        String?
  phone                       String?                      @unique
  stripeCustomerId            String?                      @unique
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  purchases                   Purchase[]
  profile                     StudentProfile?
  points                      PointsLedger[]
  packages                    PackagePurchase[]
  packageUsage                PackageUsageLedger[]
  attendances                 Attendance[]
  actionRequests              ActionRequest[]
  studentPinCredentials       StudentPinCredential[]
  studentPinAudits            StudentPinAudit[]
  kioskIdentificationSessions KioskIdentificationSession[]
  completedClassesOverride    Int?
  packageClassesUsedOverride  Int?
  dayOfWeekPurchaseCounts     DayOfWeekPurchaseCount[]
}

model StudentRecoveryDraft {
  id             String   @id @default(cuid())
  codeHash       String?  @unique
  correlationId  String   @unique
  phone          String?
  email          String?
  name           String?
  source         String
  status         String   @default("issued")
  expiresAt      DateTime
  invalidatedAt  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tickets        StudentRecoveryTicket[]

  @@index([status, expiresAt])
}

model StudentRecoveryTicket {
  id               String   @id @default(cuid())
  draftId          String
  draft            StudentRecoveryDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  tokenHash        String?  @unique
  correlationId    String   @unique
  staffClerkId     String
  status           String   @default("issued")
  expiresAt        DateTime
  consumedAt       DateTime?
  invalidatedAt    DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status, expiresAt])
  @@index([draftId])
}

model Purchase {
  id                      String            @id @default(cuid())
  userId                  String
  user                    User              @relation(fields: [userId], references: [id])
  courseSlug              String
  courseTitle             String?
  amount                  Int
  currency                String            @default("usd")
  status                  String
  email                   String?
  name                    String?
  phone                   String?
  participants            Int?
  coupon                  String?
  packageId               String?
  serviceId               String?
  addonsCsv               String?
  stripePaymentIntentId   String?           @unique
  stripeCheckoutSessionId String?           @unique
  parentPurchaseId        String?
  idempotencyKey          String?           @unique
  metadata                Json?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  packagePurchases        PackagePurchase[]

  @@index([userId])
  @@index([userId, status])
  @@index([courseSlug])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
  @@unique([parentPurchaseId])
}

model PackagePlan {
  id           String            @id @default(cuid())
  key          String            @unique
  courseSlug   String?
  courseSlugs  String[]        @default([])
  label        String
  description  String?
  priceCents   Int?
  cadence      String?
  status       String            @default("ACTIVE")
  launchAt     DateTime?
  totalCredits Int?
  makeUps      Int               @default(0)
  validDays    Int               @default(180)
  isUnlimited  Boolean           @default(false)
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  purchases    PackagePurchase[]

  @@index([courseSlug])
  @@index([courseSlugs])
  @@index([active])
  @@index([status])
  @@index([launchAt])
}

model CourseCatalog {
  id                   String   @id @default(cuid())
  slug                 String   @unique
  title                String
  kind                 String   @default("course")
  category             String?
  description          String?
  coverImageUrl        String?
  previewVideoUrl      String?
  dropInPriceCents     Int?
  firstClassPriceCents Int?
  level                String?
  durationMinutes      Int?
  location             String?
  defaultRoomId        String?
  defaultRoom          Room?    @relation(fields: [defaultRoomId], references: [id], onDelete: SetNull)
  availableWeekdays    Int[]
  availableTimes       String[]
  scheduleRules        Json?
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  mediaAssets          CourseMedia[]

  @@index([kind])
  @@index([active])
  @@index([defaultRoomId])
}

model CourseMedia {
  id         String       @id @default(cuid())
  courseId   String?
  course     CourseCatalog? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  kind       String
  mimeType   String
  sizeBytes  Int
  data       Bytes
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([courseId])
  @@index([kind])
  @@index([createdAt])
}

model Room {
  id             String          @id @default(uuid())
  name           String          @unique
  capacity       Int
  location       String?
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sessions       ClassSession[]
  defaultCourses CourseCatalog[]
  reservations   RoomReservation[]
  auditLogs      RoomAuditLog[]

  @@index([active])
}

model PointsRule {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  description String?
  eventType   String
  points      Float
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([eventType])
  @@index([active])
}

model StudentProfile {
  id                       String          @id @default(cuid())
  userId                   String          @unique
  user                     User            @relation(fields: [userId], references: [id])
  firstName                String?
  lastName                 String?
  birthDate                DateTime?
  emergencyContactName     String?
  emergencyContactRelation String?
  emergencyContactPhone    String?
  billingAddress           BillingAddress?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
}

model BillingAddress {
  id         String         @id @default(cuid())
  profileId  String         @unique
  profile    StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model PointsLedger {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  eventKey  String?  @unique
  points    Float
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
}

model PackagePurchase {
  id               String               @id @default(cuid())
  userId           String
  user             User                 @relation(fields: [userId], references: [id])
  packagePlanId    String?
  packagePlan      PackagePlan?         @relation(fields: [packagePlanId], references: [id])
  courseSlug       String?
  packageId        String
  packageLabel     String?
  totalCredits     Int?
  remainingCredits Int?
  isUnlimited      Boolean              @default(false)
  purchasedAt      DateTime             @default(now())
  expiresAt        DateTime?
  lastUsedAt       DateTime?
  status           String               @default("active")
  purchaseId       String?
  purchase         Purchase?            @relation(fields: [purchaseId], references: [id])
  source           String               @default("stripe")
  usageEntries     PackageUsageLedger[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([purchaseId])
  @@index([userId])
  @@index([packagePlanId])
  @@index([packageId])
  @@index([status])
  @@index([expiresAt])
}

model ClassSession {
  id              String       @id @default(cuid())
  courseSlug      String
  title           String?
  startsAt        DateTime
  durationMinutes Int?
  capacity        Int          @default(12)
  location        String?
  roomId          String?
  room            Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  attendances     Attendance[]

  @@unique([courseSlug, startsAt])
  @@index([courseSlug, startsAt])
  @@index([roomId, startsAt])
}

model RoomReservation {
  id                      String   @id @default(cuid())
  roomId                  String
  room                    Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  title                   String
  reason                  String
  category                String?
  startsAt                DateTime
  endsAt                  DateTime
  status                  String   @default("active")
  createdByClerkUserId    String
  assignedStaffClerkUserId String?
  cancelledAt             DateTime?
  cancelledByClerkUserId  String?
  cancellationReason      String?
  paymentId               String?           // future FK to a payment record (reservation-payments)
  cancellationPolicySnapshot Json?          // frozen policy at creation time for future enforcement
  metadata                Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([roomId, startsAt])
  @@index([status, startsAt])
  @@index([assignedStaffClerkUserId, startsAt])
}

model RoomAuditLog {
  id               String   @id @default(cuid())
  roomId           String?
  room             Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  roomNameSnapshot String
  action           String
  actorClerkUserId String
  actorRole        String
  reason           String?
  outcome          String
  blockers         Json?
  metadata         Json?
  createdAt        DateTime @default(now())

  @@index([roomId, createdAt])
  @@index([action, createdAt])
  @@index([actorClerkUserId, createdAt])
}

model Attendance {
  id           String              @id @default(cuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id])
  sessionId    String
  session      ClassSession        @relation(fields: [sessionId], references: [id])
  status       String              @default("checked_in")
  checkedInAt  DateTime            @default(now())
  checkedOutAt DateTime?
  qrToken      String?
  metadata     Json?
  packageUsage PackageUsageLedger?

  @@unique([userId, sessionId])
  @@index([userId])
  @@index([sessionId])
  @@index([status])
  @@index([checkedInAt])
  @@index([userId, status, checkedInAt])
}

model PackageUsageLedger {
  id                String          @id @default(cuid())
  packagePurchaseId String
  packagePurchase   PackagePurchase @relation(fields: [packagePurchaseId], references: [id], onDelete: Cascade)
  userId            String
  user              User            @relation(fields: [userId], references: [id])
  attendanceId      String?         @unique
  attendance        Attendance?     @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  delta             Int
  reason            String
  meta              Json?
  createdAt         DateTime        @default(now())

  @@index([packagePurchaseId])
  @@index([userId, createdAt])
  @@index([reason])
}

model ActionRequest {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  status     String    @default("PENDING")
  message    String?
  meta       Json?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status])
  @@index([type])
}

model StaffAccount {
  id                     String                       @id @default(cuid())
  clerkUserId            String                       @unique
  email                  String
  phone                  String?
  firstName              String?
  lastName               String?
  role                   String
  category               String?
  subCategory            String?
  banned                 Boolean                      @default(false)
  locked                 Boolean                      @default(false)
  hasPin                 Boolean                      @default(false)
  lastSignInAt           DateTime?
  lastCheckInAt          DateTime?
  source                 String                       @default("clerk")
  metadata               Json?
  paymentPreference      String?
  paymentInfo            Json?
  hourlyRate             Float?
  paydayWeekday          Int?
  paymentModelId         String?
  paymentModel           StaffPaymentModel?           @relation(fields: [paymentModelId], references: [id], onDelete: SetNull)
  creditCapCents         Int?
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  roleAuditTrail         StaffRoleAudit[]
  clockEntries           StaffClockEntry[]
  payrollEntries         StaffPayrollEntry[]
  creditLedgerEntries    StaffCreditLedgerEntry[]
  payrollBonuses         StaffPayrollBonus[]
  unavailabilityRequests StaffUnavailabilityRequest[]
  paymentSchedule        StaffPaymentSchedule?
  payrollAudits          StaffPayrollAudit[]
  notifications          StaffNotification[]
  paymentChangeRequests  StaffPaymentChangeRequest[]

  @@index([role])
  @@index([category])
  @@index([subCategory])
  @@index([banned, locked])
  @@index([paymentModelId])
  @@index([updatedAt])
}

model StaffPaymentModel {
  id                     String              @id @default(cuid())
  schoolId               String?
  name                   String
  type                   String              @default("per_hour")
  hourlyRate             Float
  percentageRate         Float?
  revenueBase            String?             @default("class_revenue")
  currency               String
  currencyRef            Currency            @relation("StaffPaymentModelCurrency", fields: [currency], references: [code])
  paydayWeekday          Int
  creditCapCents         Int                 @default(0)
  defaultPaymentMethodId String?
  defaultPaymentMethod   StaffPaymentMethod? @relation("StaffPaymentModelDefaultMethod", fields: [defaultPaymentMethodId], references: [id], onDelete: SetNull)
  isDefault              Boolean             @default(false)
  active                 Boolean             @default(true)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  staffAccounts          StaffAccount[]
  payrollEntries         StaffPayrollEntry[]

  @@index([schoolId])
  @@index([isDefault])
}

model StaffPaymentMethod {
  id               String              @id @default(cuid())
  schoolId         String?
  name             String
  adapterType      String
  configJson       Json?
  currency         String
  currencyRef      Currency            @relation("StaffPaymentMethodCurrency", fields: [currency], references: [code])
  active           Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  defaultForModels StaffPaymentModel[] @relation("StaffPaymentModelDefaultMethod")
  payrollEntries   StaffPayrollEntry[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([active])
}

model StaffPayrollEntry {
  id                   String              @id @default(cuid())
  staffAccountId       String
  staffAccount         StaffAccount        @relation(fields: [staffAccountId], references: [id], onDelete: Cascade)
  periodStart          DateTime
  periodEnd            DateTime
  hoursWorked          Float
  hourlyRate           Float
  grossAmount          Int
  bonusAmount          Int                 @default(0)
  totalAmount          Int
  currency             String
  currencyRef          Currency            @relation("StaffPayrollEntryCurrency", fields: [currency], references: [code])
  status               String              @default("pending")
  paymentMethodId      String?
  paymentMethod        StaffPaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  paymentModelId       String?
  paymentModel         StaffPaymentModel?  @relation(fields: [paymentModelId], references: [id], onDelete: SetNull)
  idempotencyKey       String?
  proposedAmount       Int?
  proposedBy           String?
  rejectionNote        String?
  paidAt               DateTime?
  paidBy               String?
  paidAmount           Int?
  reversedAt           DateTime?
  reversedBy           String?
  reversalReason       String?
  amountOverrideReason String?
  amountOverriddenBy   String?
  notes                String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  bonuses              StaffPayrollBonus[]
  audits               StaffPayrollAudit[]

  @@unique([staffAccountId, periodStart, periodEnd])
  @@index([staffAccountId])
  @@index([idempotencyKey])
  @@index([status])
  @@index([periodStart])
}

model StaffCreditLedgerEntry {
  id             String       @id @default(cuid())
  staffAccountId String
  staffAccount   StaffAccount @relation(fields: [staffAccountId], references: [id], onDelete: Cascade)
  type           String
  amount         Int
  note           String?
  eventKey       String?
  awardedBy      String?
  createdAt      DateTime     @default(now())

  @@unique([staffAccountId, eventKey])
  @@index([staffAccountId, createdAt])
}

model StaffPayrollBonus {
  id             String             @id @default(cuid())
  staffAccountId String
  staffAccount   StaffAccount       @relation(fields: [staffAccountId], references: [id], onDelete: Cascade)
  type           String
  amount         Int
  note           String?
  entryId        String?
  entry          StaffPayrollEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)
  expiresAt      DateTime?
  active         Boolean            @default(true)
  cancelledAt    DateTime?
  cancelledBy    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([staffAccountId, active])
  @@index([entryId])
}

model StaffUnavailabilityRequest {
  id             String       @id @default(cuid())
  staffAccountId String
  staffAccount   StaffAccount @relation(fields: [staffAccountId], references: [id], onDelete: Cascade)
  startDate      DateTime
  endDate        DateTime
  type           String
  note           String?
  status         String       @default("pending")
  reviewedBy     String?
  reviewedAt     DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([staffAccountId])
  @@index([status])
}

model StaffPaymentSchedule {
  id             String       @id @default(cuid())
  staffAccountId String       @unique
  staffAccount   StaffAccount @relation(fields: [staffAccountId], references: [id], onDelete: Cascade)
  paydayWeekday  Int
  time           String
  timezone       String
  active         Boolean      @default(true)
  nextRunAt      DateTime?
  lastRunAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model StaffPayrollAudit {
  id               String             @id @default(cuid())
  entryId          String?
  entry            StaffPayrollEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)
  staffAccountId   String?
  staffAccount     StaffAccount?      @relation(fields: [staffAccountId], references: [id], onDelete: SetNull)
  type             String
  actorClerkUserId String?
  previousValue    Json?
  nextValue        Json?
  reason           String?
  metadata         Json?
  createdAt        DateTime           @default(now())

  @@index([entryId])
  @@index([staffAccountId])
  @@index([type])
  @@index([createdAt])
}

model StaffNotification {
  id             String       @id @default(cuid())
  staffAccountId String
  staffAccount   StaffAccount @relation(fields: [staffAccountId], references: [id], onDelete: Cascade)
  type           String
  payload        Json
  read           Boolean      @default(false)
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([staffAccountId, read])
  @@index([createdAt])
}

model StaffPaymentChangeRequest {
  id              String       @id @default(cuid())
  staffAccountId  String
  staffAccount    StaffAccount @relation(fields: [staffAccountId], references: [id], onDelete: Cascade)
  requestedMethod String
  requestedInfo   Json
  reason          String?
  status          String       @default("pending") // pending, approved, rejected, cancelled
  reviewedBy      String? // Clerk User ID
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([staffAccountId])
  @@index([status])
}

model StaffRoleAudit {
  id               String        @id @default(cuid())
  staffAccountId   String?
  staffAccount     StaffAccount? @relation(fields: [staffAccountId], references: [id], onDelete: SetNull)
  staffClerkUserId String
  actorClerkUserId String?
  actorRole        String?
  action           String
  previousRole     String?
  nextRole         String?
  previousCategory String?
  nextCategory     String?
  metadata         Json?
  createdAt        DateTime      @default(now())

  @@index([staffClerkUserId, createdAt])
  @@index([actorClerkUserId, createdAt])
  @@index([action, createdAt])
}

model StaffTerminal {
  id                          String                       @id @default(cuid())
  slug                        String                       @unique
  name                        String
  location                    String?
  defaultCourseSlug           String?
  pinHash                     String
  active                      Boolean                      @default(true)
  createdByUserId             String?
  lastSeenAt                  DateTime?
  lastUsedAt                  DateTime?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  sessions                    StaffTerminalSession[]
  kioskMissCounter            KioskTerminalMissCounter?
  kioskIdentificationSessions KioskIdentificationSession[]
  preparedCheckoutContexts    PreparedCheckoutContext[]

  @@index([active])
  @@index([defaultCourseSlug])
}

model StaffTerminalSession {
  id         String        @id @default(cuid())
  terminalId String
  terminal   StaffTerminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)
  tokenHash  String        @unique
  expiresAt  DateTime
  lastSeenAt DateTime      @default(now())
  createdAt  DateTime      @default(now())

  @@index([terminalId])
  @@index([expiresAt])
}

model StudentPinCredential {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind            String
  status          String    @default("active")
  pinHash         String
  pinLookupDigest String
  failedAttempts  Int       @default(0)
  lockedAt        DateTime?
  lockReason      String?
  lastVerifiedAt  DateTime?
  lastPinAuthAt   DateTime?
  expiresAt       DateTime?
  usedAt          DateTime?
  consumedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, kind])
  @@index([kind, status, expiresAt])
  @@index([pinLookupDigest])
  @@index([pinLookupDigest, status])
  @@index([lockedAt])
}

model KioskTerminalMissCounter {
  id           String        @id @default(cuid())
  terminalId   String        @unique
  terminal     StaffTerminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)
  missCount    Int           @default(0)
  windowStart  DateTime      @default(now())
  blockedUntil DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([blockedUntil])
}

model StudentPinAudit {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  actorUserId    String?
  actorClerkId   String?
  actorRole      String?
  actorType      String
  action         String
  result         String
  credentialKind String?
  terminalId     String?
  reason         String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([actorClerkId, createdAt])
  @@index([action, createdAt])
}

model KioskIdentificationSession {
  id                  String        @id @default(cuid())
  terminalId          String
  terminal            StaffTerminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)
  userId              String
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialKind      String
  requiresPinRotation Boolean       @default(false)
  rotationBypassed    Boolean       @default(false)
  checkoutContext     Json?
  expiresAt           DateTime
  lastActivityAt      DateTime      @default(now())
  createdAt           DateTime      @default(now())

  @@index([terminalId])
  @@index([userId])
  @@index([expiresAt])
}

model PreparedCheckoutContext {
  id                   String        @id @default(cuid())
  terminalId           String
  terminal             StaffTerminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)
  kioskSessionId       String
  classSlotKey         String
  dbUserId             String?
  resolvedClerkUserId  String?
  resolvedEmail        String
  phoneRaw             String?
  phoneNormalized      String
  accountSnapshot      Json
  verificationSnapshot Json
  expiresAt            DateTime
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@unique([terminalId, kioskSessionId, classSlotKey])
  @@index([terminalId, kioskSessionId, expiresAt])
  @@index([expiresAt])
}

model StudentDataAudit {
  id             String   @id @default(cuid())
  targetUserId   String
  staffClerkId   String
  staffName      String?
  entity         String // attendance | payment | package | stats | profile
  entityId       String?
  field          String
  valueBefore    Json?
  valueAfter     Json?
  reason         String
  ipAddress      String?
  createdAt      DateTime @default(now())

  @@index([targetUserId, createdAt])
  @@index([staffClerkId, createdAt])
  @@index([entity, createdAt])
}

model CourseLink {
  id                            String   @id @default(cuid())
  courseSlugA                   String   // early class
  courseSlugB                   String   // consecutive class
  dropInConsecutiveCents        Int      // discounted drop-in price for B
  packageHolderConsecutiveCents Int      // discounted price for package holders
  active                        Boolean  @default(true)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  @@unique([courseSlugA, courseSlugB])
  @@index([courseSlugA])
  @@index([courseSlugB])
}

model StaffClockEntry {
  id                   String       @id @default(cuid())
  staffAccountId       String
  staffAccount         StaffAccount @relation(fields: [staffAccountId], references: [id], onDelete: Cascade)
  clockInAt            DateTime
  expectedClockOutAt   DateTime
  actualClockOutAt     DateTime?
  totalExpectedMinutes Int
  status               String       @default("clocked_in")
  courseSlugs          Json
  metadata             Json?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@unique([staffAccountId, clockInAt])
  @@index([staffAccountId])
  @@index([clockInAt])
  @@index([status])
}

model MonthlyBoundary {
  id              String   @id @default(cuid())
  year            Int
  month           Int // 1-12
  closedAt        DateTime?
  closedByClerkId String?
  notes           String?
  createdAt       DateTime @default(now())

  @@unique([year, month])
  @@index([closedAt])
}

model StripeWebhookEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique
  eventType   String
  status      String    @default("legacy")
  attempts    Int       @default(0)
  processedAt DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([eventType])
  @@index([processedAt])
  @@index([status])
}

model DayOfWeekPurchaseCount {
  id              String    @id @default(cuid())
  userId          String
  dayOfWeek       Int       // 0=Sunday, 6=Saturday
  count           Int       @default(0)
  lastCountedDate DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id])

  @@unique([userId, dayOfWeek])
  @@index([userId])
}

// Durable old→new clerkId map for the dev→prod Clerk instance migration
// (scripts/migrate-clerk-instance.ts, non-deployed, local-only). One row per
// migrated User or StaffAccount; `phase` tracks per-user pipeline progress so
// a partial failure (e.g. createUser succeeded, createPhoneNumber failed) is
// detectable and resumable without re-listing prod on every run. Also the
// rollback lever for the DB remap transaction — see design D2/D3.
model ClerkIdMigration {
  id         String    @id @default(cuid())
  entity     String // "user" | "staff"
  appId      String // User.id or StaffAccount.id
  oldClerkId String
  newClerkId String
  phone      String?
  email      String?
  phase      String // "user_created" | "phone_attached" | "skipped_deleted"
  createdAt  DateTime  @default(now())
  appliedAt  DateTime?

  @@unique([entity, appId])
  @@index([newClerkId])
  @@index([phase])
}
